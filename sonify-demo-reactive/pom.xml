<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.bitsar</groupId>
    <artifactId>jvm-sonify</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>sonify-demo-reactive</artifactId>
  <name>JVM Sonify :: Demo (reactive)</name>
  <description>The same scenarios on Netty instead of Tomcat, so the two concurrency models can
    be run side by side and compared.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.bitsar</groupId>
      <artifactId>sonify-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>net.bitsar</groupId>
      <artifactId>sonify-scenarios</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
