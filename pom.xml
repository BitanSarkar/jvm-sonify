<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.bitsar</groupId>
  <artifactId>jvm-sonify</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>JVM Sonify</name>
  <description>Hear and see your Spring Boot app live: JDK Flight Recorder streamed to Canvas and Web Audio.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <spring-boot.version>3.5.16</spring-boot.version>
  </properties>

  <modules>
    <module>sonify-core</module>
    <module>sonify-spring-boot-autoconfigure</module>
    <module>sonify-spring-boot-starter</module>
    <module>sonify-scenarios</module>
    <module>sonify-demo</module>
    <module>sonify-demo-reactive</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>net.bitsar</groupId>
        <artifactId>sonify-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bitsar</groupId>
        <artifactId>sonify-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bitsar</groupId>
        <artifactId>sonify-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bitsar</groupId>
        <artifactId>sonify-scenarios</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- Spring binds @PathVariable and @RequestParam by parameter name; without this
                 flag the names are erased and those bindings fail at runtime. The Boot parent
                 pom sets it, and this build imports only the BOM, so it is set here. -->
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <includes>
              <include>**/*Test.java</include>
              <include>**/*IT.java</include>
            </includes>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- M5: verify the library still auto-configures on the current Spring Boot line. -->
    <profile>
      <id>boot4</id>
      <properties>
        <spring-boot.version>4.1.1</spring-boot.version>
      </properties>
    </profile>
  </profiles>
</project>
